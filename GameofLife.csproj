<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Prevent nested test-project artifacts from being compiled as part of the application. -->
  <ItemGroup>
    <Compile Remove="GameofLife.Tests/**/*.cs" />
  </ItemGroup>

</Project>
